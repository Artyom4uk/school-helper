<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧮 Калькулятор оценок"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Сколько пятёрок нужно, чтобы поднять средний балл?"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCalcSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Предмет из дневника (например, Алгебра)"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etCalcManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Или оценки через пробел: 5 4 5 3"
            android:inputType="text"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etCalcTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Какой средний балл хочешь? (например 4.5)"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnCalc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Рассчитать" />

        <TextView
            android:id="@+id/tvCalcResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="💡 Подсказка: обычно «4» за четверть — это средний от 4.0, а «5» — от 4.5 (в разных школах по-разному)."
            android:textColor="#8A8A8A"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>